{
  "info": {
    "_postman_id": "f864d686-f6af-4b9d-9d8b-9a21820b6e4a",
    "name": "FlipPlay Media API",
    "description": "Happy path and failure path checks for the FlipPlay Laravel API. Set userId to an existing user before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "mediaId",
      "value": ""
    },
    {
      "key": "mediaTitle",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'List media') {",
          "  pm.collectionVariables.set('mediaTitle', 'Postman FlipPlay ' + Date.now());",
          "  pm.collectionVariables.unset('mediaId');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Media CRUD",
      "item": [
        {
          "name": "List media",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/media"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('contains data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create media (happy path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{mediaTitle}}\",\n  \"type\": \"Anime\",\n  \"genre\": \"Adventure\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/media"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('resource created', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.title).to.eql(pm.collectionVariables.get('mediaTitle'));",
                  "  pm.collectionVariables.set('mediaId', body.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by title",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/media?title={{mediaTitle}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "{{mediaTitle}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 and matching media found', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.some(item => item.title === pm.collectionVariables.get('mediaTitle'))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Show media",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 and correct id', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('mediaId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update media (happy path)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"genre\": \"Fantasy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 and updated genre', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.genre).to.eql('Fantasy');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create media with empty fields (failure path: 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"type\": \"\",\n  \"genre\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/media"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422 with validation errors', function () {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errors).to.have.property('title');",
                  "  pm.expect(pm.response.json().errors).to.have.property('type');",
                  "  pm.expect(pm.response.json().errors).to.have.property('genre');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate title (failure path: 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{mediaTitle}}\",\n  \"type\": \"Anime\",\n  \"genre\": \"Adventure\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/media"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422 for duplicate title', function () {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errors).to.have.property('title');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update with empty title (failure path: 422)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422 for empty title', function () {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errors).to.have.property('title');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User media collection",
      "item": [
        {
          "name": "Attach media (happy path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attach same media again (failure path: 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409 for duplicate attach', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Show user collection",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/media"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 and collection includes media', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.some(item => Number(item.id) === Number(pm.collectionVariables.get('mediaId')))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Detach media (happy path)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Detach absent media (failure path: 404)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404 for absent relation', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete media (happy path)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Show deleted media (failure path: 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/media/{{mediaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
